# Optional. The app runs with the free defaults in src/chains.js if these are unset.
PORT=47821

# Local MongoDB. Factory discovery, pool rows, and per-pool scan checkpoints live here.
# docker run -d --name pool-callers-mongo -p 27017:27017 mongo:8
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pool_callers

# Per-chain RPC override. The URL must be http(s). Paths that contain API keys
# are never sent to the browser; the UI shows only the host.
# Use a node that exposes trace_filter, trace_block, or debug_traceBlockByNumber.
# RPC_URL_1=https://eth.drpc.org
# RPC_URL_8453=https://base.drpc.org
# RPC_URL_10=https://optimism.drpc.org
# RPC_URL_42161=https://arbitrum.drpc.org
# RPC_URL_137=https://polygon.drpc.org
# RPC_URL_56=https://bsc.drpc.org
# RPC_URL_43114=https://avalanche.drpc.org

# trace_filter chunk size. Free dRPC rejects ranges over 100 blocks on some chains.
TRACE_CHUNK_BLOCKS=20
# In-flight trace chunks. Keep this low on public endpoints.
TRACE_CONCURRENCY=2
RPC_TIMEOUT_MS=45000
# Hard ceiling for one scan, even if the form asks for more.
MAX_BLOCKS_CAP=2000
TRACE_PAGE_SIZE=400
# Skip a single response larger than this instead of buffering it.
RPC_MAX_BYTES=67108864
